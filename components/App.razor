@namespace DotnetStart.Components

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0e" />
    <meta name="description" content=".NET starts here. The community front door to modern .NET — one opinionated stack, practical docs, from dotnet new to production." />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* The faces every page paints with, fetched alongside the stylesheet rather
       than after the browser has parsed it. *@
    <link rel="preload" as="font" type="font/woff2" href="fonts/manrope-400-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="fonts/manrope-800-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="fonts/ibm-plex-mono-400-latin.woff2" crossorigin />
    <link rel="icon" href="favicon.svg" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
