@namespace DotnetStart.Components.Shared

<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "arrow-right": <path d="M5 12h14M13 6l6 6-6 6" /> break;
        case "arrow-up-right": <path d="M7 17 17 7M7 7h10v10" /> break;
        case "search":
            <g>
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-4-4" />
            </g>
            break;
        case "github": <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-6 0C5.8.1 4.7.5 4.7.5A5 5 0 0 0 4.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 9 18v4M9 19c-3 .9-3-1.5-4.2-2" /> break;
        case "copy":
            <g>
                <rect x="9" y="9" width="11" height="11" rx="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </g>
            break;
        case "check": <path d="m5 12 4 4L19 6" /> break;
        case "terminal":
            <g>
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <path d="m7 9 3 3-3 3M13 15h4" />
            </g>
            break;
        case "book":
            <g>
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
            </g>
            break;
        case "spark": <path d="m12 3 1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3Z" /> break;
        case "users":
            <g>
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
            </g>
            break;
        case "branch":
            <g>
                <circle cx="6" cy="5" r="2" />
                <circle cx="18" cy="6" r="2" />
                <circle cx="6" cy="19" r="2" />
                <path d="M6 7v10M8 7c2 0 3 1 3 3s1 3 3 3h2" />
            </g>
            break;
        case "package":
            <g>
                <path d="m12 3 8 4-8 4-8-4 8-4Z" />
                <path d="m4 7 8 4 8-4v10l-8 4-8-4V7Z" />
                <path d="M12 11v10" />
            </g>
            break;
        case "wand":
            <g>
                <path d="m15 4 5 5L8 21l-5-5L15 4Z" />
                <path d="m6 14 5 5M6 4v3M4.5 5.5h3M19 14v4M17 16h4" />
            </g>
            break;
        default: <circle cx="12" cy="12" r="9" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
}
