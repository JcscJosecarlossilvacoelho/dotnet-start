@namespace DotnetStart.Components.Shared

@*
    Static markup. The copy button is wired up by app.js from the data attribute,
    so this component costs no interactivity and works on a static host.
*@
<div class="code-block @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="code-label"><span>@Label</span><span>@Language</span></div>
    }
    <div class="code-line">
        @if (ShowPrompt) { <span class="code-prompt">❯</span> }
        <code>@Code</code>
        <button class="copy-button" type="button" data-copy="@Code" aria-label="Copy command">
            <Icon Name="copy" Class="copy-idle" />
            <Icon Name="check" Class="copy-done" />
            <span>Copy</span>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Language { get; set; } = "bash";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool ShowPrompt { get; set; } = true;
}
