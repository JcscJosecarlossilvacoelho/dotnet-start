@namespace DotnetStart.Components.Layout
@inherits LayoutComponentBase

<div class="site-frame">
    <header class="site-header">
        <div class="header-inner shell">
            <a class="brand" href="/" aria-label=".NET Start — home">
                <span class="brand-glyph">.n</span>
                <span>dotnet<span>start</span></span>
            </a>

            <nav class="main-nav" aria-label="Primary navigation">
                <NavLink href="/docs">Docs</NavLink>
                <NavLink href="/skills">Skills</NavLink>
                <a href="/#stack">Stack</a>
                <a href="/#community">Community</a>
            </nav>

            <div class="header-actions">
                <SearchTrigger />
                <SupportLink />
                <a class="github-link" href="https://github.com/JcscJosecarlossilvacoelho/dotnet-start" target="_blank" rel="noreferrer" aria-label="Open the project on GitHub">
                    <Icon Name="github" />
                    <span>GitHub</span>
                </a>
            </div>
        </div>
    </header>

    <SearchPalette />
    @Body

    <footer class="site-footer">
        <div class="shell footer-grid">
            <a class="brand" href="/"><span class="brand-glyph">.n</span><span>dotnet<span>start</span></span></a>
            <p>.NET starts here. Open source, written in C#, owned by the community.</p>
            <div class="footer-links"><a href="/docs">Docs</a><a href="/skills">Skills</a><a href="https://github.com/JcscJosecarlossilvacoelho/dotnet-start">GitHub</a><a href="https://buymeacoffee.com/jcscjosecarlossilvacoelho" target="_blank" rel="noreferrer noopener">Buy me a coffee</a></div>
        </div>
    </footer>
</div>
