@namespace DotnetStart.Components.Shared

@*
    Static markup with all three states present; app.js reveals the right one from
    localStorage. Rendering every state up front means no skeleton and no flash of
    the wrong prompt.
*@
<div class="toc-feedback" data-feedback="@Slug">
    <div data-feedback-state="ask">
        <span>Did this page help?</span>
        <div>
            <button type="button" data-feedback-vote="yes" aria-label="Yes, it helped">Yes</button>
            <button type="button" data-feedback-vote="no" aria-label="No, it did not help">No</button>
        </div>
    </div>
    <div data-feedback-state="yes" hidden>
        <span class="thanks">Thanks — that is how we know what to keep.</span>
    </div>
    <div data-feedback-state="no" hidden>
        <span>Sorry it missed. Tell us what was wrong.</span>
        <div>
            <a class="button button-ghost" href="@IssueUrl">Open an issue</a>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";

    private string IssueUrl => $"https://github.com/JcscJosecarlossilvacoelho/dotnet-start/issues/new?title={Uri.EscapeDataString($"Docs: {Slug} was not useful")}&body={Uri.EscapeDataString($"The page `/docs/{Slug}` did not help.\n\nWhat I expected:\n\nWhat I found:\n")}";
}
