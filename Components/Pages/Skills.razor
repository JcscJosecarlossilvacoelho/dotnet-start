@namespace DotnetStart.Components.Pages
@page "/skills"

<PageTitle>Skills · .NET Start</PageTitle>

<main>
    <section class="skills-hero shell">
        <div class="status-pill"><span></span> Open, versioned skills</div>
        <h1>Give your agent<br /><em>.NET</em> context.</h1>
        <p>Specialized instructions so Claude and Codex make better calls in .NET projects — installable in one command, auditable on GitHub.</p>
        <div class="skills-install"><CodeBlock Code="npx skills add JcscJosecarlossilvacoelho/dotnet-start" Label="INSTALL ALL" /></div>
    </section>

